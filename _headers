/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # 'unsafe-inline' on script-src is load-bearing: the theme-boot snippet has to
  # run before first paint (a nonce would need a dynamic origin) and each page
  # renders its own data inline. Everything else is locked down — there are two
  # frame targets: inflight.info, which serves the crew center, the application
  # form and the live-traffic embed, and the InGdo backend, which serves the
  # events + calendar embed off its own origin (both driven by the one embed
  # token in assets/js/live.js). Only inflight.info is a connect target; the
  # embeds call their own backends from inside their own frames, which this
  # page's CSP does not govern.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; frame-src https://inflight.info https://site--indgo-backend--6dmjph8ltlhv.code.run; connect-src 'self' https://inflight.info; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'self'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/brand.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300
